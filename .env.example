# Your Supabase project credentials (Supabase dashboard -> Project Settings -> API)
# Use the PUBLISHABLE (or "anon") key here — never the secret / service_role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Set to "true" only after enabling the Google provider in Supabase (Authentication -> Providers)
VITE_ENABLE_GOOGLE_SIGNIN=false
